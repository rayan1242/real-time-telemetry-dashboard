# Copy to deploy/aws/.env and never commit the filled file.
# Use a real DNS name pointed at your EC2 public IP for automatic HTTPS.
DOMAIN=dashboard.example.com
PUBLIC_ORIGIN=https://dashboard.example.com
# Use URL-safe secrets for DATABASE_URL interpolation.
POSTGRES_PASSWORD=replace-with-long-url-safe-password
INGEST_API_KEY=replace-with-random-ingest-secret
DASHBOARD_TOKEN=replace-with-different-random-operator-secret
MAX_QUEUE_LAG=5000
