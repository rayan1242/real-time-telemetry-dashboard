{$DOMAIN::80} {
  encode gzip zstd
  handle /api/* {
    reverse_proxy api:3000
  }
  handle /socket.io/* {
    reverse_proxy api:3000
  }
  handle /health {
    reverse_proxy api:3000
  }
  handle /live {
    reverse_proxy api:3000
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
