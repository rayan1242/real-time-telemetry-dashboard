PORT=3000
DATABASE_URL=postgres://telemetry:telemetry@localhost:5432/telemetry
REDIS_URL=redis://localhost:6379
CLIENT_ORIGIN=http://localhost:5173
INGEST_API_KEY=local-demo-key-change-me
DASHBOARD_TOKEN=local-dashboard-token-change-me

# Optional: bind individual ingestion credentials to specific device IDs.
# When set, DEVICE_API_KEYS replaces the shared INGEST_API_KEY fallback.
# DEVICE_API_KEYS='{"robot-001":"replace-with-unique-secret"}'

# The API queues accepted events; the worker writes them to PostgreSQL.
# Redis AOF is enabled in Docker Compose (everysec, not zero-loss durability).

# Approximate Redis consumer-group lag threshold for HTTP 429 overload response.
MAX_QUEUE_LAG=5000
